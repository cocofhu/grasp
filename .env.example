# Copied to .env on first ./start.sh. Defaults pull published GHCR images
# (no local Docker build). Override tags/digests as needed.

GRASP_PORT=8080
GRASP_GATEWAY_PORT=8899
GRASP_SANDBOX_GATEWAY_URL=http://127.0.0.1:8899
GRASP_DEPLOYMENT_MODE=local-demo

# Shared gateway Bearer token (SBGW_API_KEYS + GRASP_SANDBOX_GATEWAY_API_KEY).
# local-demo default; change before exposing beyond loopback.
SANDBOX_GATEWAY_API_KEY=grasp-local-demo

# Published images (GHCR). Tag 1.1.0 matches the current public packages.
# Prefer @sha256:... digests for immutable releases / ./release-smoke.sh.
GRASP_IMAGE=ghcr.io/cocofhu/grasp:1.1.0
SANDBOX_GATEWAY_IMAGE=ghcr.io/cocofhu/sandbox-gateway:1.1.0

# One sandbox image for every acpBackend (five CLIs preinstalled; runtime
# AGENT_PROVIDER picks the live CLI). ./start.sh maps SANDBOX_IMAGE →
# GRASP_SANDBOX_IMAGE and SBGW_IMAGE when those are unset.
SANDBOX_IMAGE=ghcr.io/cocofhu/universal-sandbox:1.1.0
# GRASP_SANDBOX_IMAGE=
# Optional per-backend override (leave unset to use the image above):
# GRASP_SANDBOX_IMAGE_CURSOR=
# GRASP_SANDBOX_IMAGE_CLAUDE_CODE=
# GRASP_SANDBOX_IMAGE_CODEBUDDY=
# GRASP_SANDBOX_IMAGE_TRAE=
# GRASP_SANDBOX_IMAGE_OPENCODE=

# Loopback doctor control-plane token. Empty → ./start.sh generates one.
GRASP_DOCTOR_TOKEN=

# Demo login admin/demo1234 is injected by ./start.sh (GRASP_AUTH_USERS).
# Do not put bcrypt hashes in this file — `$` is mangled by shell/compose .env.

# Optional: source-build / HMR stack via `./start.sh dev`
# GRASP_GATEWAY_SANDBOX_IMAGE=universal-sandbox:local
# AGENT_PROVIDERS=cursor
# SANDBOX_GATEWAY_DIR=./sandbox-gateway
# GOPROXY=https://goproxy.cn,direct
# GOSUMDB=sum.golang.google.cn
# Optional: pin the overview-page service commit for `./start.sh dev`.
# Empty → start.sh uses `git rev-parse HEAD` when available.
# GIT_COMMIT=
