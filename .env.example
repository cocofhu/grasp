# Copied to .env on first ./start.sh. Defaults pull published GHCR images
# (no local Docker build). Override tags/digests as needed.

GRASP_PORT=8080
GRASP_GATEWAY_PORT=8899
GRASP_SANDBOX_GATEWAY_URL=http://127.0.0.1:8899
GRASP_DEPLOYMENT_MODE=local-demo

# Shared gateway Bearer token (SBGW_API_KEYS + GRASP_SANDBOX_GATEWAY_API_KEY).
# local-demo default; change before exposing beyond loopback.
SANDBOX_GATEWAY_API_KEY=grasp-local-demo

# Published images (GHCR) for the v3.4 cleanup release.
# Existing v3.2 data must complete the v3.3 migration first; see server/UPGRADING.md.
# Prefer @sha256:... digests for immutable releases / ./release-smoke.sh.
GRASP_IMAGE=ghcr.io/cocofhu/grasp:3.4.0
SANDBOX_GATEWAY_IMAGE=ghcr.io/cocofhu/sandbox-gateway:3.4.0

# One sandbox image for every acpBackend (CLIs preinstalled, including
# Codex and Kimi Code; runtime AGENT_PROVIDER picks the live CLI).
# ./start.sh maps SANDBOX_IMAGE → GRASP_SANDBOX_IMAGE and SBGW_IMAGE
# when those are unset.
SANDBOX_IMAGE=ghcr.io/cocofhu/universal-sandbox:3.4.0
# GRASP_SANDBOX_IMAGE=
# Optional per-backend override (leave unset to use the image above):
# GRASP_SANDBOX_IMAGE_CURSOR=
# GRASP_SANDBOX_IMAGE_CLAUDE_CODE=
# GRASP_SANDBOX_IMAGE_CODEBUDDY=
# GRASP_SANDBOX_IMAGE_TRAE=
# GRASP_SANDBOX_IMAGE_OPENCODE=
# GRASP_SANDBOX_IMAGE_CODEX=
# GRASP_SANDBOX_IMAGE_DEEPSEEK_HARNESS=
# GRASP_SANDBOX_IMAGE_KIMI_CODE=

# Credential encryption key (base64, 32 bytes). Empty → ./start.sh generates
# one and writes it here. Keep it stable: changing it makes saved credentials
# unreadable.
GRASP_SECRETS_KEY=

# Optional: "Sign in with GitHub" for github.com workspace credentials.
# Client ID of your own GitHub OAuth App with "Enable Device Flow" checked
# (no client secret needed). Empty → tokens are pasted manually.
# GRASP_GITHUB_OAUTH_CLIENT_ID=

# Loopback doctor control-plane token. Empty → ./start.sh generates one.
GRASP_DOCTOR_TOKEN=

# Payload storage (requires the Solo-continuation migration release or source
# stack).
# Set driver=s3 AND GRASP_LOCAL_OBJECTSTORE=1 explicitly for local SeaweedFS.
# An empty S3 endpoint alone is rejected; cloud endpoints never fall back locally.
# start.sh persists its data and generated credentials under .localdata/objectstore
# (source stack: .devdata/objectstore). External endpoints never fall back locally.
# GRASP_STORAGE_DRIVER=s3
# Leave GRASP_S3_ENDPOINT empty with this flag; conflicting selections fail.
# GRASP_LOCAL_OBJECTSTORE=1
# GRASP_S3_ENDPOINT=
# GRASP_S3_BUCKET=grasp
# GRASP_S3_PREFIX=application
# GRASP_S3_REGION=us-east-1
# GRASP_S3_ACCESS_KEY_ID=
# GRASP_S3_SECRET_ACCESS_KEY=
# GRASP_S3_SESSION_TOKEN=
# GRASP_S3_PATH_STYLE=true
# GRASP_LOCAL_OBJECTSTORE_PORT=8333
# start.sh uses the current non-root host UID/GID; root uses a non-root data
# owner (10001 for new stores). Only the private data/IAM mounts change owner.
# GRASP_LOCAL_OBJECTSTORE_UID=10001
# GRASP_LOCAL_OBJECTSTORE_GID=10001
# GRASP_LOCAL_OBJECTSTORE_IMAGE=chrislusf/seaweedfs:4.53@sha256:ccad23e18639c8b98cee17e7100b95830a06077b56d8e5b006d6dcf8ec5e94a0

# Execution continuity is separate from payload storage and SQL backups.
# Fresh install only, with all application writers stopped:
#   ./start.sh init-execution --offline
# Source stack: ./start.sh dev init-execution --offline
# Ordinary up/restart never initializes a missing control marker.
# Keep .localdata/{execution-control,execution-maintenance} (or .devdata for dev)
# independent from SQL/app-data; preserve the original fresh-install workdir.
GRASP_EXECUTION_CONTROL_DRIVER=local
GRASP_EXECUTION_CONTROL_BLOBS_ROOT=/execution-control
# Remote control storage requires its OWN explicit credentials and a disjoint
# namespace; these are never inferred from GRASP_S3_* payload credentials.
# GRASP_EXECUTION_CONTROL_S3_ENDPOINT=
# GRASP_EXECUTION_CONTROL_S3_REGION=us-east-1
# GRASP_EXECUTION_CONTROL_S3_BUCKET=
# GRASP_EXECUTION_CONTROL_S3_PREFIX=execution-control
# GRASP_EXECUTION_CONTROL_S3_ACCESS_KEY_ID=
# GRASP_EXECUTION_CONTROL_S3_SECRET_ACCESS_KEY=
# GRASP_EXECUTION_CONTROL_S3_SESSION_TOKEN=
# GRASP_EXECUTION_CONTROL_S3_PATH_STYLE=true

# Demo login admin/demo1234 is injected by ./start.sh (GRASP_AUTH_USERS).
# Do not put bcrypt hashes in this file — `$` is mangled by shell/compose .env.

# Optional: source-build / HMR stack via `./start.sh dev`
# GRASP_GATEWAY_SANDBOX_IMAGE=universal-sandbox:local
# AGENT_PROVIDERS=cursor
# Sandbox Dockerfile apt/docker-ce mirrors (default true = Tsinghua).
# start.sh retries the image build with false if the CN-mirror build fails.
# USE_CN_MIRROR=true
# SANDBOX_GATEWAY_DIR=./sandbox-gateway
# GOPROXY=https://goproxy.cn,direct
# GOSUMDB=sum.golang.google.cn
# Optional: pin the overview-page service commit for `./start.sh dev`.
# Empty → start.sh uses `git rev-parse HEAD` when available.
# GIT_COMMIT=
