{
  "name": "grasp-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build && node scripts/assert-no-novnc-secure-context.mjs && node ../scripts/assert-no-approving-brand.mjs",
    "preview": "vite preview --host",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ci": "playwright test e2e/gate-mobile-fill.spec.ts e2e/clarify-inbox-product.spec.ts e2e/delete-run-list.spec.ts e2e/cancel-run.spec.ts e2e/agent-create-wizard.spec.ts e2e/board-token-stats.spec.ts e2e/run-detail-mobile.spec.ts e2e/run-detail-mobile-panel.spec.ts e2e/gate-share-link.spec.ts e2e/shell-loading.spec.ts",
    "lint": "eslint .",
    "assert:novnc-http": "node scripts/assert-no-novnc-secure-context.mjs",
    "assert:brand": "node ../scripts/assert-no-approving-brand.mjs",
    "measure:lcp": "node scripts/measure-lcp.mjs",
    "measure:lcp2": "node scripts/measure-lcp2.mjs",
    "build:page-control": "node scripts/build-page-control.mjs"
  },
  "dependencies": {
    "@novnc/novnc": "^1.5.0",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.2",
    "@vue-flow/core": "^1.42.1",
    "@vue-flow/minimap": "^1.5.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "dompurify": "^3.2.3",
    "echarts": "^6.1.0",
    "html-to-image": "^1.11.13",
    "jspdf": "^4.2.1",
    "marked": "^15.0.6",
    "mermaid": "^11.17.0",
    "monaco-editor": "^0.52.2",
    "pinia": "^2.3.0",
    "vue": "^3.5.13",
    "vue-echarts": "^8.2.0",
    "vue-i18n": "^10.0.7",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@page-agent/page-controller": "1.12.4",
    "@playwright/test": "^1.61.1",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vitest/coverage-v8": "^4.1.11",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.4.11",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.5",
    "eslint-plugin-vue": "^10.10.0",
    "happy-dom": "^20.10.6",
    "playwright": "^1.61.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^4.1.11",
    "vue-tsc": "^2.2.0",
    "ws": "^8.18.0"
  },
  "overrides": {
    "brace-expansion": "^5.0.9",
    "minimatch": "^10.2.5",
    "js-yaml": "^4.3.2",
    "browserslist": "^4.28.7"
  },
  "license": "MIT"
}
