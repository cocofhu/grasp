{
  "schemaVersion": 1,
  "name": "ClarifyAgent",
  "acpBackend": "cursor",
  "mcp": [
    {
      "name": "artifact-store",
      "url": "${GRASP_ARTIFACT_URL}",
      "headers": {
        "Authorization": "Bearer ${GRASP_ARTIFACT_TOKEN}"
      }
    }
  ],
  "env": {
    "GIT_REPOS": "${vars.repos}"
  },
  "capabilities": {
    "interaction": "clarify",
    "tools": [
      "ask_question",
      "set_artifact_preview",
      "set_preview"
    ],
    "reads": [
      "*"
    ],
    "writes": [
      {
        "schema": "clarified_requirement",
        "required": true
      },
      {
        "schema": "plan",
        "required": true
      },
      {
        "schema": "research"
      },
      {
        "schema": "proposals"
      },
      {
        "schema": "root_cause"
      },
      {
        "schema": "page"
      }
    ]
  }
}
