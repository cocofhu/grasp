{
  "schemaVersion": 1,
  "name": "ImplementAgent",
  "acpBackend": "cursor",
  "mcp": [
    {
      "name": "artifact-store",
      "url": "${GRASP_ARTIFACT_URL}",
      "headers": {
        "Authorization": "Bearer ${GRASP_ARTIFACT_TOKEN}"
      }
    }
  ],
  "env": {
    "GIT_REPOS": "${vars.repos}"
  },
  "capabilities": {
    "interaction": "auto",
    "review": true,
    "tools": [
      "set_preview",
      "update_plan_status"
    ],
    "reads": [
      "*"
    ],
    "writes": [
      {
        "schema": "implementation_result",
        "required": true
      }
    ]
  }
}
