[
  {"id": "browser", "name": "Browser", "nameZh": "浏览器", "exec": ["/usr/local/bin/desktop-session.sh", "browser"], "runtime": true, "category": "system", "icons": ["web-browser", "chromium"]},
  {"id": "terminal", "name": "Terminal", "nameZh": "终端", "exec": ["lxterminal", "--working-directory=/root/workspace"], "category": "system", "icons": ["lxterminal", "utilities-terminal"]},
